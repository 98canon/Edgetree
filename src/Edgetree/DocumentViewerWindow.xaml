<Window x:Class="SidebarExplorer.App.DocumentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SidebarExplorer.App.Controls"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="Edgetree"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Background="{DynamicResource ViewerBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource PanelDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel>
                <Button x:Name="CloseWindowButton"
                        DockPanel.Dock="Right"
                        Content="×"
                        Width="28"
                        Height="24"
                        Margin="6,0,0,0"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="关闭"
                        Click="CloseWindowButton_Click"
                        Background="Transparent"
                        Foreground="{DynamicResource AccentForeground}"
                        FontWeight="Bold"
                        BorderBrush="{DynamicResource AccentForeground}"
                        BorderThickness="1"/>
                <Button x:Name="AddTabButton"
                        DockPanel.Dock="Right"
                        Content="+"
                        Width="28"
                        Height="24"
                        Margin="6,0,0,0"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="{x:Static services:Strings.DocumentNewTab}"
                        Click="AddTabButton_Click"
                        Background="Transparent"
                        Foreground="{DynamicResource ForegroundText}"
                        BorderBrush="{DynamicResource ViewerChipBorderBrush}"
                        BorderThickness="1"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        CanContentScroll="True">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <controls:DocumentPane x:Name="DocPane"
                Grid.Row="1"
                ShowPopOut="False"/>
        <Grid x:Name="ImageHost"
                Grid.Row="1"
                Visibility="Collapsed"
                ClipToBounds="True"
                Background="{DynamicResource ViewerBackground}"
                MouseWheel="ImageHost_MouseWheel"
                MouseLeftButtonDown="ImageHost_MouseLeftButtonDown"
                MouseMove="ImageHost_MouseMove"
                MouseLeftButtonUp="ImageHost_MouseLeftButtonUp"
                LostMouseCapture="ImageHost_LostMouseCapture">
            <Image x:Name="PreviewImage"
                    Stretch="Uniform"
                    RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageZoom" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ImagePan"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
        <TextBlock x:Name="EmptyHint"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.55"
                Foreground="{DynamicResource ForegroundText}"
                Text="{x:Static services:Strings.DocumentPickFile}"/>
    </Grid>
</Window>
