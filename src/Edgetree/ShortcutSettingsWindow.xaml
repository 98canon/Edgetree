<Window x:Class="SidebarExplorer.App.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.ShortcutSettingsTitle}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}"
        Foreground="{DynamicResource DialogForeground}"
        FontSize="{DynamicResource DialogFontSize}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="×"
                    Width="28"
                    Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Close_Click"/>
            <TextBlock Text="{x:Static services:Strings.ShortcutSettingsTitle}"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock Text="{x:Static services:Strings.ShortcutHint}"
                TextWrapping="Wrap"
                Opacity="0.75"
                Margin="0,0,0,12"/>
        <StackPanel x:Name="Rows"/>
    </StackPanel>
</Window>
